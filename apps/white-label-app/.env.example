ZERNIO_API_KEY=sk_your_key_here
ZERNIO_API_BASE=https://zernio.com/api/v1
BASE_URL=http://localhost:3000
WEBHOOK_SECRET=any_long_random_string

# Only needed for webhooks (the one inbound direction). Point it at a public
# tunnel; BASE_URL stays localhost so OAuth redirects still land in the browser.
WEBHOOK_URL=https://your-host.ts.net:8443/webhooks/zernio

# Inbox (optional). Local SQLite store for send attempts, webhook events and the message cache.
INBOX_DB=./data/inbox.db
# How long a send may wait before its outcome is treated as unknown (never auto-resent).
ZERNIO_SEND_TIMEOUT_MS=15000
# Local-only by default: this portal has no user login. Do not bind it to a public interface.
HOST=127.0.0.1
PORT=3000

# Signs the client report link when "Show spend" is on, so editing the URL cannot reveal spend.
# Falls back to WEBHOOK_SECRET when unset.
REPORT_LINK_SECRET=another_long_random_string
